	partition Calendar-942da334-4065-4391-9186-c29f90a9be42 = m
		mode: import
		source = ```
				let
				    // configurations start
				    //Today=DateTime.LocalNow(), // today's date
				    //FromYear = 2011, // set the start year of the date dimension. dates start from 1st of January of this year
				    //ToYear=2015, // set the end year of the date dimension. dates end at 31st of December of this year
				    StartofFiscalYear=7, // set the month number that is start of the financial year. example; if fiscal year start is July, value is 7
				    firstDayofWeek=Day.Monday, // set the week's start day, values: Day.Monday, Day, Sunday....
				     //configuration end
				    
				    FromDate=#date(2011,1,1),
				    ToDate= Date.EndOfMonth(DateTime.Date(DateTime.LocalNow())),
				
				    Source=List.Dates(
				        FromDate,
				        Duration.Days(ToDate-FromDate)+1,
				        #duration(1,0,0,0)
