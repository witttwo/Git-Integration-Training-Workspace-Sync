/// Asserts that the mean of a column falls within the specified range.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {DOUBLE} minIncl - Minimum inclusive mean value
/// @param {DOUBLE} maxIncl - Maximum inclusive mean value
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.MeanShouldBeInRange' =
		(testName : STRING, columnRef : ANYREF EXPR, minIncl : DOUBLE, maxIncl : DOUBLE, severity : INT64 = 2) =>
			VAR _MeanVal = AVERAGEX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _Passed = _MeanVal >= minIncl && _MeanVal <= maxIncl
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Mean in [" & FORMAT(minIncl, "") & ", " & FORMAT(maxIncl, "") & "]",
				"ActualValue", "Mean=" & FORMAT(_MeanVal, ""),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
