function 'PQL.Assert.Col.ShareOfZerosAtMost' =
		(testName : STRING, columnRef : ANYREF EXPR, maxPct : DOUBLE, severity : INT64 = 2) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _ZeroCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(columnRef = 0, 1, BLANK()))
			VAR _ZeroPct = IF(_TotalCount = 0, 0, DIVIDE(_ZeroCount, _TotalCount) * 100)
			VAR _Passed = _ZeroPct <= maxPct
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Zero share <= " & FORMAT(maxPct, "0.##") & "%",
				"ActualValue", FORMAT(_ZeroPct, "0.##") & "% (" & FORMAT(_ZeroCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")",
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: ede76934-86c0-4db6-ab9c-6b2255800887

