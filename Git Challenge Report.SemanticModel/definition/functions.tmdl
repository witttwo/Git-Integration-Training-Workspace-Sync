/// Object Level Security (OLS) Assertions - PQL.Assert.OLS namespace
/// Publisher: PQL (Power Query Lint)
/// These functions test metadata visibility to verify OLS is properly configured.
/// Use with "View as" role context in Power BI Desktop to validate security settings.
/// Asserts that a table is hidden from metadata (OLS metadataPermission = none).
/// Use this when a role should NOT have access to view or query a table.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} tableName - Name of the table to check
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.OLS.TableShouldBeHidden' =
		(testName : STRING, tableName : STRING, severity : INT64 = 2) =>
			VAR _Tables = INFO.VIEW.TABLES()
			VAR _IsVisible = COUNTROWS(FILTER(_Tables, [Name] = tableName)) > 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Table '" & tableName & "' should be HIDDEN from metadata",
				"ActualValue", IF(_IsVisible, "VISIBLE (OLS not working)", "HIDDEN (OLS working)"),
				"Passed", IF(NOT _IsVisible, 1, 0),
				"Severity", severity
			)
	lineageTag: 4ebd0f77-a61f-47aa-9a8c-ed800f666331

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a table is visible in metadata (OLS allows access).
/// Use this when a role SHOULD have access to view or query a table.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} tableName - Name of the table to check
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.OLS.TableShouldBeVisible' =
		(testName : STRING, tableName : STRING, severity : INT64 = 2) =>
			VAR _Tables = INFO.VIEW.TABLES()
			VAR _IsVisible = COUNTROWS(FILTER(_Tables, [Name] = tableName)) > 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Table '" & tableName & "' should be VISIBLE in metadata",
				"ActualValue", IF(_IsVisible, "VISIBLE (correct)", "HIDDEN (unexpected)"),
				"Passed", IF(_IsVisible, 1, 0),
				"Severity", severity
			)
	lineageTag: 2e128a21-d30c-4738-8c5b-14f477782d32

