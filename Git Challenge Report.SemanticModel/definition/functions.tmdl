/// Asserts that a value is NULL (DAX BLANK()).
function 'PQL.Assert.ShouldBeNull' =
		(testName : STRING, actualValue : VARIANT, severity : INT64 = 2) =>
		    VAR _Passed = ISBLANK(actualValue)
		    RETURN ROW(
		        "TestName", testName,
		        "ExpectedValue", "NULL",
		        "ActualValue", IF(ISBLANK(actualValue), "NULL", IF(EXACT(actualValue, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", IF(_Passed, 1, 0),
		        "Severity", severity
		    )
	lineageTag: 03997478-ec26-4a30-b1a1-734c129289e6

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a value is not NULL (not DAX BLANK()). Accepts both simple values and expressions.
function 'PQL.Assert.ShouldNotBeNull' =
		(testName : STRING, actualValue : SCALAR VARIANT EXPR, severity : INT64 = 2) =>
		    VAR _ActualResult = actualValue
		    VAR _Passed = NOT ISBLANK(_ActualResult)
		    RETURN ROW(
		        "TestName", testName,
		        "ExpectedValue", "NOT NULL",
		        "ActualValue", IF(ISBLANK(_ActualResult), "NULL", IF(EXACT(_ActualResult, ""), "BLANK (empty string)", "HAS VALUE")),
		        "Passed", IF(_Passed, 1, 0),
		        "Severity", severity
		    )
	lineageTag: aaa48a65-cd11-45ec-b0e1-e7bf1fa5226f

