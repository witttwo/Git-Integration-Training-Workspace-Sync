/// Asserts that a table has at least a minimum number of partitions, with optional date range filtering.
/// Uses INFO.PARTITIONS() to validate partition volume for incremental and rolling window partition strategies.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} tableName - Name of the table to check partitions for
/// @param {INT64} minimumCount - Minimum partition count threshold (actual must be greater than or equal to this value)
/// @param {DATETIME} [startDate] - Optional start date filter (filters by RangeStart >= startDate)
/// @param {DATETIME} [endDate] - Optional end date filter (filters by RangeEnd <= endDate)
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Partitions.ShouldBeAtLeast' =
		(testName: STRING, tableName: STRING, minimumCount: INT64, startDate: DATETIME = BLANK(), endDate: DATETIME = BLANK(), severity: INT64 = 2) =>
		    VAR _Partitions = INFO.PARTITIONS()
		    VAR _Tables =
		        SELECTCOLUMNS(
		            INFO.TABLES(),
		            "TableID", [ID],
		            "TableName", [Name]
		        )
		    VAR _PartitionMetadata = NATURALLEFTOUTERJOIN(_Partitions, _Tables)
		    VAR _PartitionMetadataWithDates =
		        ADDCOLUMNS(
		            _PartitionMetadata,
		            "_RangeStartDate", IFERROR(DATEVALUE([RangeStart]), BLANK()),
		            "_RangeEndDate", IFERROR(DATEVALUE([RangeEnd]), BLANK())
		        )
		    VAR _Filtered =
		        FILTER(
		            _PartitionMetadataWithDates,
		            [TableName] = tableName
		            && (
		                ISBLANK(startDate)
		                || (NOT ISBLANK([_RangeStartDate]) && [_RangeStartDate] >= startDate)
		            )
		            && (
		                ISBLANK(endDate)
		                || (NOT ISBLANK([_RangeEndDate]) && [_RangeEndDate] <= endDate)
		            )
		        )
		    VAR _ActualCount = COUNTROWS(_Filtered)
		    VAR _Passed = _ActualCount >= minimumCount
		    VAR _DateFilter =
		        IF(
		            NOT ISBLANK(startDate) || NOT ISBLANK(endDate),
		            " (Inclusive date bounds: " &
		            IF(NOT ISBLANK(startDate), "Start >= " & FORMAT(startDate, "yyyy-MM-dd"), "") &
		            IF(NOT ISBLANK(startDate) && NOT ISBLANK(endDate), ", ", "") &
		            IF(NOT ISBLANK(endDate), "End <= " & FORMAT(endDate, "yyyy-MM-dd"), "") &
		            ")",
		            ""
		        )
		    RETURN ROW(
		        "TestName", testName,
		        "ExpectedValue", "Partition count >= " & FORMAT(minimumCount, "0") & _DateFilter,
		        "ActualValue", "Partition count = " & FORMAT(_ActualCount, "0") & " for table '" & tableName & "'",
		        "Passed", IF(_Passed, 1, 0),
		        "Severity", severity
		    )
