/// String Assertions - PQL.Assert namespace
/// Asserts that a string starts with the specified prefix (case-insensitive).
function 'PQL.Assert.ShouldStartWith' =
		(testName : STRING, prefix : STRING, actual : STRING, severity : INT64 = 2) =>
		    VAR _Passed = LEFT(UPPER(actual), LEN(prefix)) = UPPER(prefix)
		    RETURN ROW(
		        "TestName", testName,
		        "ExpectedValue", "Starts with '" & prefix & "'",
		        "ActualValue", actual,
		        "Passed", IF(_Passed, 1, 0),
		        "Severity", severity
		    )
	lineageTag: d1de954e-73e4-4c23-b638-a280611fb1dd

