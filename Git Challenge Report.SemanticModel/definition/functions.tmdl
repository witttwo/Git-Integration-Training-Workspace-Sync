/// Uniqueness & Key-Like Behavior
/// Asserts that column values are unique within partitions defined by another column.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {ANYREF EXPR} partitionByCol - Column to partition by
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ShouldBeUniqueWithin' =
		(testName : STRING, columnRef : ANYREF EXPR, partitionByCol : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _Base = FILTER(ALL(partitionByCol, columnRef), NOT ISBLANK(columnRef))
			VAR _TotalCombinations = COUNTROWS(DISTINCT(_Base))
			VAR _TotalRows = COUNTA(columnRef)
			VAR _Passed = _TotalCombinations = _TotalRows
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "All values unique within partition",
				"ActualValue", IF(_Passed, "ALL UNIQUE WITHIN PARTITION (" & FORMAT(_TotalRows, "0") & " rows)", "DUPLICATES WITHIN PARTITION (" & FORMAT(_TotalCombinations, "0") & " unique of " & FORMAT(_TotalRows, "0") & " rows)"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 72930b1f-18cf-43b6-be34-6c1b75ae7070

