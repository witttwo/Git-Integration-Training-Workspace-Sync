/// Asserts that no text values in a column have leading or trailing spaces.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.TextShouldHaveNoLeadingOrTrailingSpaces' =
		(testName : STRING, columnRef : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _UntrimmedCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(NOT ISBLANK(columnRef) && FORMAT(columnRef, "") <> TRIM(FORMAT(columnRef, "")), 1, BLANK()))
			VAR _Passed = _UntrimmedCount = 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "No leading or trailing spaces",
				"ActualValue", IF(_Passed, "ALL TRIMMED (" & FORMAT(_TotalCount, "0") & " rows)", "UNTRIMMED VALUES (" & FORMAT(_UntrimmedCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: da12f1b1-c4d4-4b2a-b33f-e969193f3c5e

