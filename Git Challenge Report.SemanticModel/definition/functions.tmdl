/// Asserts that text lengths in a column fall within the specified range.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {INT64} minLen - Minimum text length
/// @param {INT64} maxLen - Maximum text length
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.TextLengthShouldBeInRange' =
		(testName : STRING, columnRef : ANYREF EXPR, minLen : INT64, maxLen : INT64, severity : INT64 = 2) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _OutOfRangeCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(NOT ISBLANK(columnRef) && (LEN(FORMAT(columnRef, "")) < minLen || LEN(FORMAT(columnRef, "")) > maxLen), 1, BLANK()))
			VAR _Passed = _OutOfRangeCount = 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Text length in [" & FORMAT(minLen, "0") & ", " & FORMAT(maxLen, "0") & "]",
				"ActualValue", IF(_Passed, "ALL IN RANGE (" & FORMAT(_TotalCount, "0") & " rows)", "OUT OF RANGE (" & FORMAT(_OutOfRangeCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 025bda89-deeb-4984-9a63-69879b9db353

