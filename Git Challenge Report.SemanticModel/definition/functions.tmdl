/// Range & Distribution Checks (Numeric)
/// Asserts that all values in a numeric column fall within the specified inclusive range.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {DOUBLE} minIncl - Minimum inclusive value
/// @param {DOUBLE} maxIncl - Maximum inclusive value
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ShouldBeInRange' =
		(testName : STRING, columnRef : ANYREF EXPR, minIncl : DOUBLE, maxIncl : DOUBLE, severity : INT64 = 2) =>
			VAR _MinVal = MINX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _MaxVal = MAXX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _Passed = _MinVal >= minIncl && _MaxVal <= maxIncl
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", FORMAT(minIncl, "") & " <= value <= " & FORMAT(maxIncl, ""),
				"ActualValue", "Min=" & FORMAT(_MinVal, "") & ", Max=" & FORMAT(_MaxVal, ""),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: aaba54df-2029-4237-9c85-e8000cfe818b

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

