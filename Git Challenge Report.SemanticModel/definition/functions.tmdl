/// Asserts that values in a column are monotonically strictly increasing when ordered by another column.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {ANYREF EXPR} orderedByCol - Column to order by for monotonic check
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ShouldBeMonotonicIncreasing' =
		(testName : STRING, columnRef : ANYREF EXPR, orderedByCol : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _Tbl = ADDCOLUMNS(
				ALLNOBLANKROW(columnRef),
				"@OrderVal", orderedByCol
			)
			VAR _Sorted = ADDCOLUMNS(
				_Tbl,
				"@RowNum", RANKX(_Tbl, [@OrderVal], , ASC, DENSE)
			)
			VAR _WithPrev = ADDCOLUMNS(
				_Sorted,
				"@PrevVal", VAR _CurRank = [@RowNum] RETURN MAXX(FILTER(_Sorted, [@RowNum] = _CurRank - 1), columnRef)
			)
			VAR _Violations = COUNTAX(_WithPrev, IF(NOT ISBLANK([@PrevVal]) && columnRef <= [@PrevVal], 1, BLANK()))
			VAR _Passed = _Violations = 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Values monotonically increasing",
				"ActualValue", IF(_Passed, "MONOTONIC INCREASING", "NOT MONOTONIC (" & FORMAT(_Violations, "0") & " violations)"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 3a91e034-e1e7-48b7-8c7c-7b7a4f400359

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

