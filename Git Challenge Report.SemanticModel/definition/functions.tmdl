/// Asserts that the distinct count of values in a column is at most the specified number.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {INT64} maxDistinct - Maximum allowed distinct count
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.DistinctCountShouldBeAtMost' =
		(testName : STRING, columnRef : ANYREF EXPR, maxDistinct : INT64, severity : INT64 = 2) =>
			VAR _DistinctCount = DISTINCTCOUNT(columnRef)
			VAR _Passed = _DistinctCount <= maxDistinct
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Distinct count <= " & FORMAT(maxDistinct, "0"),
				"ActualValue", "Distinct count = " & FORMAT(_DistinctCount, "0"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
