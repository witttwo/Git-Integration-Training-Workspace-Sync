/// Asserts that the share of odd values in a column is at least the specified percentage.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {DOUBLE} minPct - Minimum required odd percentage (0-100)
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ShareOfOddsAtLeast' =
		(testName : STRING, columnRef : ANYREF EXPR, minPct : DOUBLE, severity : INT64 = 2) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _OddCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(MOD(columnRef, 2) <> 0, 1, BLANK()))
			VAR _OddPct = IF(_TotalCount = 0, 0, DIVIDE(_OddCount, _TotalCount) * 100)
			VAR _Passed = _OddPct >= minPct
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Odd share >= " & FORMAT(minPct, "0.##") & "%",
				"ActualValue", FORMAT(_OddPct, "0.##") & "% (" & FORMAT(_OddCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")",
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: cf8cb34d-0e1c-40dd-a2f7-6fd22ebfa9db

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Sign & Monotonicity
/// Asserts that all values in a column are non-negative (>= 0).
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ShouldBeNonNegative' =
		(testName : STRING, columnRef : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _MinVal = MINX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _NegativeCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(columnRef < 0, 1, BLANK()))
			VAR _Passed = _NegativeCount = 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "All values >= 0",
				"ActualValue", IF(_Passed, "ALL NON-NEGATIVE (Min=" & FORMAT(_MinVal, "") & ")", "NEGATIVE VALUES FOUND (" & FORMAT(_NegativeCount, "0") & ", Min=" & FORMAT(_MinVal, "") & ")"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: b001e3e5-6889-43ec-b79f-3e45441ed701

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that all values in a column are strictly positive (> 0).
