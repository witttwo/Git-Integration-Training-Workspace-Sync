function 'PQL.Assert.ShouldBeBetween' =
		(testName : STRING, lowerBound : DOUBLE, upperBound : DOUBLE, actual : DOUBLE, severity : INT64 = 2) =>
		    VAR _Passed = actual >= lowerBound && actual <= upperBound
		    RETURN ROW(
		        "TestName", testName,
		        "ExpectedValue", FORMAT(lowerBound, "") & " <= value <= " & FORMAT(upperBound, ""),
		        "ActualValue", FORMAT(actual, ""),
		        "Passed", IF(_Passed, 1, 0),
