/// Test Discovery Functions - PQL.Assert namespace
/// Uses INFO.FUNCTIONS only - compatible with Power Automate REST API.
/// Returns function names of test functions (ending with .Test or .Tests).
/// For full metadata including Description and RLS ImpersonatedUserName, use RetrieveTestsV2.
function 'PQL.Assert.RetrieveTests' =
		() =>
		    SELECTCOLUMNS(
		        FILTER(
		            INFO.FUNCTIONS("ORIGIN", "2"),
		            OR(RIGHT([FUNCTION_NAME], 5) = ".Test", RIGHT([FUNCTION_NAME], 6) = ".Tests")
		        ),
		        "Name", [FUNCTION_NAME]
		    )
	lineageTag: 471b74b7-4738-461a-a7b6-bb9e9a311fb0

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Retrieves tests filtered by environment. Looks for .{ENV}. or .ANY. in function names.
/// If environment is blank, returns all tests.
/// Supports any custom environment naming convention (DEV, TEST, PROD, UAT, STAGING, etc.)
/// Uses INFO.FUNCTIONS only - compatible with Power Automate REST API.
/// For full metadata including Description and RLS ImpersonatedUserName, use RetrieveTestsByEnvironmentV2.
/// @param {STRING} [environment] - Optional environment filter (DEV, TEST, PROD, etc.). Default is "" (all tests).
function 'PQL.Assert.RetrieveTestsByEnvironment' =
		(environment: STRING = "") =>
		    VAR _EnvUpper = UPPER(environment)
		    RETURN
		        SELECTCOLUMNS(
		            FILTER(
		                INFO.FUNCTIONS("ORIGIN", "2"),
		                (RIGHT([FUNCTION_NAME], 5) = ".Test" || RIGHT([FUNCTION_NAME], 6) = ".Tests")
		                && (
		                    ISBLANK(_EnvUpper) || _EnvUpper = ""
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), "." & _EnvUpper & ".")
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), ".ANY.")
		                )
		            ),
		            "Name", [FUNCTION_NAME]
		        )
	lineageTag: 00237521-6bca-4623-ba68-370ef5229482

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Retrieves all test functions with full metadata (Description, RLS ImpersonatedUserName, RoleName).
/// Uses INFO.USERDEFINEDFUNCTIONS and INFO.ANNOTATIONS - NOT compatible with Power Automate REST API.
/// Use RetrieveTests for Power Automate compatibility.
function 'PQL.Assert.RetrieveTestsV2' =
		() =>
		    VAR _BaseFunctions =
		        SELECTCOLUMNS(
		            FILTER(
		                INFO.FUNCTIONS("ORIGIN", "2"),
		                OR(RIGHT([FUNCTION_NAME], 5) = ".Test", RIGHT([FUNCTION_NAME], 6) = ".Tests")
		            ),
		            "Name", [FUNCTION_NAME]
		        )
		    RETURN
		        ADDCOLUMNS(
		            _BaseFunctions,
		            "Description",
		            VAR _funcName = [Name]
		            RETURN
		            IFERROR(
		                MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [Description]),
		                BLANK()
		            ),
		            "PQLAssert_ImpersonatedUserName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_ImpersonatedUserName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            ),
		            "PQLAssert_RoleName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_RoleName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            )
		        )
	lineageTag: 0a3b2565-15aa-4c5c-b4b7-29bb998b5050

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Retrieves tests filtered by environment with full metadata (Description, RLS ImpersonatedUserName, RoleName).
/// Looks for .{ENV}. or .ANY. in function names. If environment is blank, returns all tests.
/// Uses INFO.USERDEFINEDFUNCTIONS and INFO.ANNOTATIONS - NOT compatible with Power Automate REST API.
/// Use RetrieveTestsByEnvironment for Power Automate compatibility.
/// @param {STRING} [environment] - Optional environment filter (DEV, TEST, PROD, etc.). Default is "" (all tests).
function 'PQL.Assert.RetrieveTestsByEnvironmentV2' =
		(environment: STRING = "") =>
		    VAR _EnvUpper = UPPER(environment)
		    VAR _BaseFunctions =
		        SELECTCOLUMNS(
		            FILTER(
		                INFO.FUNCTIONS("ORIGIN", "2"),
		                (RIGHT([FUNCTION_NAME], 5) = ".Test" || RIGHT([FUNCTION_NAME], 6) = ".Tests")
		                && (
		                    ISBLANK(_EnvUpper) || _EnvUpper = ""
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), "." & _EnvUpper & ".")
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), ".ANY.")
		                )
		            ),
		            "Name", [FUNCTION_NAME]
		        )
		    RETURN
		        ADDCOLUMNS(
		            _BaseFunctions,
		            "Description",
		            VAR _funcName = [Name]
		            RETURN
		            IFERROR(
		                MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [Description]),
		                BLANK()
		            ),
		            "PQLAssert_ImpersonatedUserName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_ImpersonatedUserName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            ),
		            "PQLAssert_RoleName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
