/// Presence / Completeness Thresholds
/// Asserts that the null rate of a column is at most the specified percentage.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {DOUBLE} maxNullPct - Maximum allowed null percentage (0-100)
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.NullRateShouldBeAtMost' =
		(testName : STRING, columnRef : ANYREF EXPR, maxNullPct : DOUBLE, severity : INT64 = 2) =>
			VAR _TotalCount = COUNTROWS(ALLNOBLANKROW(columnRef))
			VAR _NullCount = COUNTBLANK(columnRef)
			VAR _NullPct = IF(_TotalCount = 0, 0, DIVIDE(_NullCount, _TotalCount) * 100)
			VAR _Passed = _NullPct <= maxNullPct
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Null rate <= " & FORMAT(maxNullPct, "0.##") & "%",
				"ActualValue", FORMAT(_NullPct, "0.##") & "% (" & FORMAT(_NullCount, "0") & " of " & FORMAT(_TotalCount, "0") & ")",
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 00ee79f1-95b6-4904-8400-491d0dca28c9

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

