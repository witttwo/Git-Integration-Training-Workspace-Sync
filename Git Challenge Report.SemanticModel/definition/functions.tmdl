/// Asserts that a column exists in a table.
function 'PQL.Assert.Col.ShouldExist' =
		(testName : STRING, tableName : STRING, columnName : STRING, severity : INT64 = 2) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _Found = COUNTROWS(FILTER(_Columns, [Table] = tableName && [Name] = columnName)) > 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Column '" & tableName & "[" & columnName & "]' exists",
				"ActualValue", IF(_Found, "EXISTS", "NOT FOUND"),
				"Passed", IF(_Found, 1, 0),
				"Severity", severity
			)
	lineageTag: 690f351b-b694-4fea-a5f1-4664eaaf2782

