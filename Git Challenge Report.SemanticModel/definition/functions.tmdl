/// Asserts that a column is hidden from metadata (OLS columnPermission = none).
/// Use this when a role should NOT have access to view or query a column.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} tableName - Name of the table containing the column
/// @param {STRING} columnName - Name of the column to check
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.OLS.ColumnShouldBeHidden' =
		(testName : STRING, tableName : STRING, columnName : STRING, severity : INT64 = 2) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _IsVisible = COUNTROWS(FILTER(_Columns, [Table] = tableName && [Name] = columnName)) > 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "Column '" & tableName & "[" & columnName & "]' should be HIDDEN from metadata",
				"ActualValue", IF(_IsVisible, "VISIBLE (OLS not working)", "HIDDEN (OLS working)"),
				"Passed", IF(NOT _IsVisible, 1, 0),
				"Severity", severity
			)
	lineageTag: 3574d668-c46c-4401-bdda-e83f2420101a

