/// Relationship Assertions - PQL.Assert.Relationship namespace
function 'PQL.Assert.Relationship.ShouldExist' =
		(testName : STRING, fromTable : STRING, fromColumn : STRING, toTable : STRING, toColumn : STRING, severity : INT64 = 2) =>
		    VAR _Relationships = INFO.VIEW.RELATIONSHIPS()
		    VAR _Found = COUNTROWS(FILTER(_Relationships,
		        [FromTable] = fromTable && [FromColumn] = fromColumn &&
		        [ToTable] = toTable && [ToColumn] = toColumn)) > 0
		    RETURN ROW(
		        "TestName", testName,
		        "ExpectedValue", "Relationship '" & fromTable & "[" & fromColumn & "] -> " & toTable & "[" & toColumn & "]' exists",
		        "ActualValue", IF(_Found, "EXISTS", "NOT FOUND"),
		        "Passed", IF(_Found, 1, 0),
		        "Severity", severity
		    )
	lineageTag: e093f387-47c5-43a0-9139-87f8a1198af0

