/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ShouldBePositive' =
		(testName : STRING, columnRef : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _MinVal = MINX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _NonPositiveCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(columnRef <= 0, 1, BLANK()))
			VAR _Passed = _NonPositiveCount = 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "All values > 0",
				"ActualValue", IF(_Passed, "ALL POSITIVE (Min=" & FORMAT(_MinVal, "") & ")", "NON-POSITIVE VALUES FOUND (" & FORMAT(_NonPositiveCount, "0") & ", Min=" & FORMAT(_MinVal, "") & ")"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
