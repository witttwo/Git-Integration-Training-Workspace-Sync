/// Asserts that the combination of two columns forms a distinct composite key.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef1 - First column reference
/// @param {ANYREF EXPR} columnRef2 - Second column reference
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ComboShouldBeDistinct' =
		(testName : STRING, columnRef1 : ANYREF EXPR, columnRef2 : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _Base = FILTER(ALL(columnRef1, columnRef2), NOT ISBLANK(columnRef1))
			VAR _DistinctCombos = COUNTROWS(DISTINCT(_Base))
			VAR _TotalRows = COUNTA(columnRef1)
			VAR _Passed = _DistinctCombos = _TotalRows
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "All combinations distinct (composite key)",
				"ActualValue", IF(_Passed, "ALL COMBOS DISTINCT (" & FORMAT(_TotalRows, "0") & " rows)", "DUPLICATE COMBOS (" & FORMAT(_DistinctCombos, "0") & " distinct of " & FORMAT(_TotalRows, "0") & " rows)"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 3a24fc41-3aae-45b6-8fa1-84e053a64ae6

