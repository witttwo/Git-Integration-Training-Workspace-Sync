/// Categorical / Membership / Format
/// Asserts that all values in a column are in the specified allowed set (table).
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {TABLE EXPR} allowedValuesTable - Table containing allowed values
/// @param {ANYREF EXPR} allowedValuesColumn - Column containing the allowed values
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ValuesShouldBeInSet' =
		(testName : STRING, columnRef : ANYREF EXPR, allowedValuesTable : TABLE EXPR, allowedValuesColumn : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _TargetValues = SELECTCOLUMNS(
				DISTINCT(columnRef),
				"@Value", CONVERT(columnRef, STRING)
			)
			VAR _AllowedValues = SELECTCOLUMNS(
				allowedValuesTable,
				"@Value", CONVERT(allowedValuesColumn, STRING)
			)
			VAR _InvalidCount = COUNTROWS(EXCEPT(_TargetValues, _AllowedValues))
			VAR _Passed = _InvalidCount = 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "All values in allowed set",
				"ActualValue", IF(_Passed, "ALL VALUES IN SET", "VALUES OUTSIDE SET (" & FORMAT(_InvalidCount, "0") & " invalid)"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 5790594f-f24a-4798-92f8-acf5a34b8de6

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that no values in a column are in the specified banned set (table).
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {TABLE EXPR} bannedValuesTable - Table containing banned values
/// @param {ANYREF EXPR} bannedValuesColumn - Column containing the banned values
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.ValuesShouldNotBeInSet' =
		(testName : STRING, columnRef : ANYREF EXPR, bannedValuesTable : TABLE EXPR, bannedValuesColumn : ANYREF EXPR, severity : INT64 = 2) =>
			VAR _TargetValues = SELECTCOLUMNS(
				DISTINCT(columnRef),
				"@Value", CONVERT(columnRef, STRING)
			)
			VAR _BannedValues = SELECTCOLUMNS(
				bannedValuesTable,
				"@Value", CONVERT(bannedValuesColumn, STRING)
			)
			VAR _BannedFound = COUNTROWS(INTERSECT(_TargetValues, _BannedValues))
			VAR _Passed = _BannedFound = 0
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "No values in banned set",
				"ActualValue", IF(_Passed, "NO BANNED VALUES FOUND", "BANNED VALUES FOUND (" & FORMAT(_BannedFound, "0") & ")"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 39a40799-0f45-449e-b3ff-6e06a4e562ff

	annotation DAXLIB_PackageId = PQL.Assert

