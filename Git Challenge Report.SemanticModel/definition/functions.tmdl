/// Asserts that the standard deviation of a column is at most the specified value.
/// @param {STRING} testName - Description of the test being performed
/// @param {ANYREF EXPR} columnRef - Column reference to test
/// @param {DOUBLE} maxStdDev - Maximum allowed standard deviation
/// @param {INT64} [severity] - Test severity level (1=warning, 2=error, 3=critical). Default: 2
function 'PQL.Assert.Col.StdDevShouldBeAtMost' =
		(testName : STRING, columnRef : ANYREF EXPR, maxStdDev : DOUBLE, severity : INT64 = 2) =>
			VAR _TblRef = ALLNOBLANKROW(columnRef)
			VAR _Mean = AVERAGEX(_TblRef, columnRef)
			VAR _N = COUNTROWS(_TblRef)
			VAR _SumSqDiff = SUMX(_TblRef, (columnRef - _Mean) ^ 2)
			VAR _StdDev = IF(_N > 1, SQRT(DIVIDE(_SumSqDiff, _N - 1)), 0)
			VAR _Passed = _StdDev <= maxStdDev
			RETURN ROW(
				"TestName", testName,
				"ExpectedValue", "StdDev <= " & FORMAT(maxStdDev, ""),
				"ActualValue", "StdDev=" & FORMAT(_StdDev, "0.##"),
				"Passed", IF(_Passed, 1, 0),
				"Severity", severity
			)
	lineageTag: 302e15c9-2be2-4225-bde1-2820b98e01fe

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

